<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Database\Doctheca.Database.csproj" />
    <ProjectReference Include="..\Domain\Doctheca.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Mapster" Version="10.0.13" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="OpenSearch.Net" Version="2.2.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- ServiceMantle.Web types used directly by the Service layer: ServiceLogContext for the
         background worker's own identity scope (the singleton instance is owned and registered
         by the Host's ServiceMantle foundation) and the
         RequireServiceMantleSecurityResponseHeaders marker for the JSON admin endpoints (the
         capability and middleware themselves are registered by the Host). The Service layer
         references the library only for those types and never references the Host. Kept in
         lockstep with the Host's ServiceMantle.Web version (0.2.1 GA) so the same assembly is
         never double-pinned. -->
    <PackageReference Include="ServiceMantle.Web" Version="0.2.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Doctheca.Tests" />
  </ItemGroup>

</Project>
