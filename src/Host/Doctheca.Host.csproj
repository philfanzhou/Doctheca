<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OpenSearch.Net" Version="2.2.0" />
    <PackageReference Include="ServiceMantle.Diagnostics" Version="0.2.1" />
    <!-- PostgreSQL migration capabilities for the startup orchestration (issue #53): the
         session advisory lock provider (PostgreSqlMigrationLockProvider) and the target
         preparation provider (PostgreSqlDatabaseTargetPreparationProvider). Same 0.2.1
         release tag as every other ServiceMantle package in this host. -->
    <PackageReference Include="ServiceMantle.Database.PostgreSql" Version="0.2.1" />
    <!-- All ServiceMantle packages in this host share the 0.2.1 release tag so contracts and
         transitive dependencies stay consistent across the same host. 0.2.1 is the GA of the
         capabilities this host relies on (bounded per-category MinimumLevelOverrides, fixed
         Loki stream labels, AllowInsecureHttp acceptance, the safe Problem Details middleware,
         and AddConditionalExceptionMapping); it is the same source commit as the previous
         0.2.1-rc.1 pins, so no behavior changes with the rename. -->
    <PackageReference Include="ServiceMantle.Logging" Version="0.2.1" />
    <!-- Must stay in lockstep with the Service layer's direct ServiceMantle.Web reference so
         the same assembly is never double-pinned. -->
    <PackageReference Include="ServiceMantle.Web" Version="0.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Service\Doctheca.Service.csproj" />
    <ProjectReference Include="..\Consul\Doctheca.Consul.csproj" />
    <ProjectReference Include="..\Common\Doctheca.Common.csproj" />
    <ProjectReference Include="..\Ai\Doctheca.Ai.csproj" />
    <ProjectReference Include="..\Database\Doctheca.Database.csproj" />
  </ItemGroup>

</Project>
