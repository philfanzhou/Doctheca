<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="OpenSearch.Net" Version="2.2.0" />
    <PackageReference Include="ServiceMantle.Diagnostics" Version="0.2.0" />
    <!-- Pinned pre-release: 0.2.1-rc.1 is the first Logging package carrying the bounded
         per-category MinimumLevelOverrides, explicit fixed Loki stream labels, and the
         explicit AllowInsecureHttp acceptance this host relies on (same combination already
         shipped in Ruoyu.Admin). Do not float this version. -->
    <PackageReference Include="ServiceMantle.Logging" Version="0.2.1-rc.1" />
    <!-- Pinned pre-release: 0.2.1-rc.1 is the first Web package carrying the safe Problem
         Details middleware and AddConditionalExceptionMapping this host relies on (0.2.0
         has neither). Must stay in lockstep with the Service layer's direct ServiceMantle.Web
         reference so the same assembly is never double-pinned. Do not float this version. -->
    <PackageReference Include="ServiceMantle.Web" Version="0.2.1-rc.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Service\Doctheca.Service.csproj" />
    <ProjectReference Include="..\Consul\Doctheca.Consul.csproj" />
    <ProjectReference Include="..\Common\Doctheca.Common.csproj" />
    <ProjectReference Include="..\Ai\Doctheca.Ai.csproj" />
    <ProjectReference Include="..\Database\Doctheca.Database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Doctheca.Tests" />
  </ItemGroup>

</Project>
