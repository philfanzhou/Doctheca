{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://ruoyu-loki:3100",
          "labels": [
            {
              "key": "service",
              "value": "Ruoyu.Study.DocLibrary"
            }
          ]
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "Name": "ruoyu_study_doclibrary"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ruoyu_study_doclibrary;Username=phil"
  },
  "Endpoints": {
    "Http": 5012
  },
  "Consul": {
    "Host": "host.docker.internal",
    "Port": 8500,
    "ServiceName": "Ruoyu.Study.DocLibrary",
    "KvPrefix": "config/ruoyu",
    "TimeoutMs": 3000,
    "RetryCount": 3,
    "EnableCache": true,
    "CacheDirectory": "./data/consul"
  },
  "Loki": {
    "Uri": "http://localhost:3100"
  },
  "Oss": {
    "Endpoint": "localhost:8333",
    "AccessKey": "mock_access_key",
    "SecretKey": "mock_secret_key",
    "BucketName": "ruoyu-study",
    "PublicEndpoint": "https://ry.zhoufan.asia"
  },
  "OpenSearch": {
    "Url": "http://localhost:9200",
    "UrlComment": "Set to http://<remote-lan-ip>:9200 if OpenSearch runs on another machine",
    "IndexName": "doclibrary-segments"
  },
  "LlmDocumentAnalysis": {
    "ApiKey": "",
    "BaseUrl": "https://api.xiaomimimo.com/v1",
    "Model": "mimo-v2.5-pro",
    "ContextLength": "128K"
  },
  "MinerU": {
    "ApiToken": "",
    "BaseUrl": "https://mineru.net",
    "ModelVersion": "vlm"
  },
  "FileConversion": {
    "Url": "http://doc-converter:5050",
    "TimeoutSeconds": 120
  }
}
